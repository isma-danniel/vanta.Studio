
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VANTA STUDIO</title>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;700;800&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style>

*{
margin:0;
padding:0;
box-sizing:border-box;
scroll-behavior:smooth;
}

body{
font-family:'Poppins',sans-serif;
background:#050505;
color:white;
overflow-x:hidden;
}

body::before{
content:'';
position:fixed;
width:100%;
height:100%;
background:
radial-gradient(circle at top left, rgba(138,43,226,0.18), transparent 30%),
radial-gradient(circle at bottom right, rgba(244,185,66,0.15), transparent 30%);
z-index:-1;
}

/* HEADER */

header{
position:fixed;
top:0;
width:100%;
padding:25px 8%;
display:flex;
justify-content:space-between;
align-items:center;
background:rgba(0,0,0,0.45);
backdrop-filter:blur(20px);
border-bottom:1px solid rgba(255,255,255,0.05);
z-index:999;
}

.logo{
font-family:'Orbitron',sans-serif;
font-size:28px;
font-weight:700;
letter-spacing:8px;
background:linear-gradient(90deg,#9f5cff,#ffffff,#f4b942);
-webkit-background-clip:text;
-webkit-text-fill-color:transparent;
}

nav a{
color:white;
text-decoration:none;
margin-left:35px;
font-size:14px;
transition:0.3s;
}

nav a:hover{
color:#f4b942;
}

/* HERO */

.hero{
height:100vh;
display:flex;
justify-content:center;
align-items:center;
text-align:center;
padding:0 10%;
position:relative;
}

.hero::before{
content:'';
position:absolute;
width:500px;
height:500px;
background:#8A2BE2;
filter:blur(180px);
opacity:0.18;
left:-100px;
top:-100px;
}

.hero::after{
content:'';
position:absolute;
width:500px;
height:500px;
background:#f4b942;
filter:blur(180px);
opacity:0.15;
right:-100px;
bottom:-100px;
}

.hero-content{
position:relative;
z-index:2;
}

.hero-content h1{
font-size:100px;
font-family:'Orbitron',sans-serif;
letter-spacing:12px;
line-height:1.1;
margin-bottom:20px;
background:linear-gradient(90deg,#9f5cff,#ffffff,#f4b942);
-webkit-background-clip:text;
-webkit-text-fill-color:transparent;
}

.hero-content p{
font-size:20px;
color:#cfcfcf;
max-width:900px;
margin:auto;
line-height:1.8;
margin-bottom:40px;
}

.hero-buttons{
display:flex;
justify-content:center;
gap:20px;
flex-wrap:wrap;
}

.primary-btn{
padding:16px 40px;
border:none;
border-radius:14px;
background:linear-gradient(90deg,#8A2BE2,#f4b942);
color:white;
font-weight:600;
cursor:pointer;
transition:0.4s;
box-shadow:0 0 30px rgba(138,43,226,0.4);
}

.primary-btn:hover{
transform:translateY(-5px);
}

.secondary-btn{
padding:16px 40px;
border-radius:14px;
background:transparent;
border:1px solid rgba(255,255,255,0.1);
color:white;
cursor:pointer;
transition:0.3s;
backdrop-filter:blur(10px);
}

.secondary-btn:hover{
border-color:#f4b942;
color:#f4b942;
}

/* SECTION */

section{
padding:120px 8%;
}

.section-title{
font-size:48px;
font-family:'Orbitron',sans-serif;
text-align:center;
margin-bottom:70px;
background:linear-gradient(90deg,#9f5cff,#f4b942);
-webkit-background-clip:text;
-webkit-text-fill-color:transparent;
}

/* SERVICES */

.services-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
gap:30px;
}

.service-card{
background:rgba(255,255,255,0.03);
border:1px solid rgba(255,255,255,0.06);
padding:40px;
border-radius:25px;
transition:0.4s;
backdrop-filter:blur(20px);
}

.service-card:hover{
transform:translateY(-10px);
box-shadow:0 0 30px rgba(138,43,226,0.25);
border-color:#8A2BE2;


  
